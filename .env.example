# Copy to .env for local runs (docker-compose sets these automatically).
# SQLAlchemy URL — note the +psycopg driver (psycopg 3).
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/clinic

# All wall-clock reasoning (working hours, "today") happens in this timezone.
# Timestamps are always STORED in UTC; this is only how we interpret local time.
CLINIC_TIMEZONE=Africa/Nairobi

# Slot length in minutes.
SLOT_DURATION_MINUTES=30

# Bonus rule: reject bookings starting less than this many minutes from now.
# Set to 0 to disable the lead-time rule.
MIN_LEAD_MINUTES=60
