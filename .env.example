# Copy to .env for local runs (docker-compose sets these automatically).
# SQLAlchemy URL — note the +psycopg driver (psycopg 3).
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/clinic

# All wall-clock reasoning (working hours, "today") happens in this timezone.
# Timestamps are always STORED in UTC; this is only how we interpret local time.
CLINIC_TIMEZONE=Africa/Nairobi

# Slot length in minutes.
SLOT_DURATION_MINUTES=30

# Bonus rule: reject bookings starting less than this many minutes from now.
# Set to 0 to disable the lead-time rule.
MIN_LEAD_MINUTES=60

# JWT signing secret — MUST be set to a long random value in production.
SECRET_KEY=dev-insecure-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=720

# Rate limiting. Storage is in-memory (per worker) unless a Redis URL is given.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=120/minute
RATE_LIMIT_BOOKING=15/minute
RATE_LIMIT_STORAGE_URI=memory://

# Pagination defaults.
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# Celery / Redis (async notifications).
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Email notifications via Gmail SMTP. Off by default.
# SMTP_PASSWORD must be a Gmail *App Password* (Account > Security > 2-Step
# Verification > App passwords), NOT your normal account password.
NOTIFICATIONS_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=Clinic Booking <no-reply@clinic.example>
# If set, ALL notifications go here instead of the patient's email (for testing).
NOTIFY_OVERRIDE_EMAIL=

# Reminders: send when an appointment is within this many minutes; scan cadence.
REMINDER_LEAD_MINUTES=1440
REMINDER_SCAN_INTERVAL_MINUTES=15
